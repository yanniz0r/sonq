{
  "name": "sonq",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=@sonq/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "eslint": "^9.39.5",
    "prettier": "^3.8.1",
    "turbo": "^2.6.0",
    "typescript": "^6.0.3"
  }
}
